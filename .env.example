# Copy to .env. Never commit .env. Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATABASE_URL="file:./dev.db"
SESSION_SECRET="replace-with-32+-char-random-string"
SESSION_TTL_HOURS=8
HELIX_WEBHOOK_SECRET="replace-with-shared-secret"
APP_BASE_URL="http://localhost:3000"
SURVEY_EXPIRY_DAYS=7
HELIX_MODE=mock
BWF_MODE=mock
